rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/progress/{documentId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId) && request.resource.data.keys().hasOnly(['gameId', 'data'])
        && request.resource.data.gameId is string && request.resource.data.gameId.size() <= 100
        && request.resource.data.data is string && request.resource.data.data.size() <= 24000;
    }
    match /users/{userId}/custom/{documentId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId) && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 24000;
    }
    match /users/{userId}/sessions/{documentId} {
      allow read: if owns(userId);
      allow create, update: if owns(userId) && request.resource.data.keys().hasOnly(['gameId', 'openedAt'])
        && request.resource.data.gameId is string && request.resource.data.openedAt is int;
    }
  }
}
